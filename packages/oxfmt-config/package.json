{
  "name": "@tanstack/oxfmt-config",
  "version": "0.0.0",
  "description": "Shared Oxfmt config used by TanStack projects.",
  "author": "tannerlinsley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/config.git",
    "directory": "packages/oxfmt-config"
  },
  "homepage": "https://tanstack.com/config",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "scripts": {
    "test:types": "tsc",
    "test:oxlint": "oxlint ./src",
    "build": "tsdown"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "preferGlobal": false,
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tanstack/oxlint-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0"
  }
}
